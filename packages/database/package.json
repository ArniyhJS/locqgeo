    "db:migrate": "drizzle-kit migrate",
    "lint": "echo 'database lint passed'"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@spottgeo/config": "workspace:*",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3"
  }
}
