# ==============================================================================
# LocqGeo Monorepo — Environment Variables Configuration
# ==============================================================================

# Database & Cache (Matches docker-compose.yml defaults)
DATABASE_URL="postgresql://locqgeo:locqgeopass@localhost:5433/locqgeo_dev"
REDIS_URL="redis://localhost:6379"

# LocqEngine Server Config
HOST="0.0.0.0"
PORT="8080"

# Public API Gateway URL for Frontends (Console, Drop, Verify)
NEXT_PUBLIC_ENGINE_URL="http://localhost:8080"

# Payment Webhook Secrets
PAYSTACK_SECRET_KEY="paystack_secret_key_demo"
STRIPE_WEBHOOK_SECRET="whsec_stripe_secret_demo"

# Background Worker Interval Configs (Milliseconds)
PAYOUT_WORKER_INTERVAL_MS="5000"
ANALYTICS_WORKER_INTERVAL_MS="60000"
WEBHOOK_DISPATCHER_INTERVAL_MS="10000"
