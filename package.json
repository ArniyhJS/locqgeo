{
  "name": "spottgeo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified TypeScript Monorepo for SpottGeo Labs",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:drop": "turbo run dev --filter=@spottgeo/drop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @spottgeo/database db:generate",
    "db:migrate": "pnpm --filter @spottgeo/database db:migrate",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:console": "turbo run dev --filter=@spottgeo/console",
    "dev:engine": "turbo run dev --filter=@spottgeo/engine",
    "dev:verify": "turbo run dev --filter=@spottgeo/verify"
  },
  "devDependencies": {
    "turbo": "^2.10.6",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.17.0"
}
