{
  "name": "locqgeo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Monorepo for LocqGeo Labs",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:drop": "turbo run dev --filter=@locqgeo/drop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @locqgeo/database db:generate",
    "db:migrate": "pnpm --filter @locqgeo/database db:migrate",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:console": "turbo run dev --filter=@locqgeo/console",
    "dev:engine": "turbo run dev --filter=@locqgeo/engine",
    "dev:verify": "turbo run dev --filter=@locqgeo/verify",
    "dev:payout-worker": "turbo run dev --filter=@locqgeo/payout-worker",
    "dev:webhook-dispatcher": "turbo run dev --filter=@locqgeo/webhook-dispatcher",
    "dev:analytics-worker": "turbo run dev --filter=@locqgeo/analytics-worker",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "@locqgeo/config": "workspace:*",
    "prettier": "^3.5.0"
  },
  "packageManager": "pnpm@11.17.0"
}
